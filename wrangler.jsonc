// Cloudflare Workers config for enerfab.lk.
// IMPORTANT: "name" must be exactly the name of your Worker in the Cloudflare
// dashboard (Workers & Pages list), or the Git build will fail.
{
  "name": "efpl-website",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Non-secret settings for the inquiry form. Secrets (TURNSTILE_SECRET_KEY,
  // RESEND_API_KEY) are added in the dashboard under Settings > Variables and secrets.
  "vars": {
    "MAIL_TO": "info@enerfab.lk",
    "MAIL_FROM": "EnerFab Website <website@enerfab.lk>"
  }
}
